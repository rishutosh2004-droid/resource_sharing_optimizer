{
  "name": "Resource Sharing Optimizer",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "Frontend (React App)",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "Backend API (FastAPI)",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash -c 'cd backend && pip install -r requirements.txt && python -m app.database_init && python -m app.seed && cd ../frontend && npm install'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
